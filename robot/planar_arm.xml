<mujoco model="embody_planar_two_link_arm">
  <compiler angle="radian" inertiafromgeom="false" fusestatic="false"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="Euler"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.05" limited="true"/>
    <geom friction="0 0 0" rgba="0.42 0.55 0.62 1"/>
  </default>
  <custom><numeric name="goal_q" data="0.7 -1.0"/></custom>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1"/>
    <camera name="arm_camera" pos="1.5 -2 2" xyaxes="0.8 0.6 0 -0.4 0.5 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.01" rgba="0.15 0.18 0.2 1"/>
    <!-- Fixed mount keeps the existing worker's mass-handshake ABI identifier. -->
    <body name="carriage">
      <inertial pos="0 0 0.1" mass="0.5" diaginertia="0.002 0.002 0.002"/>
      <geom name="arm_mount" type="box" pos="0 0 0.1" size="0.07 0.07 0.1"/>
      <body name="link1" pos="0 0 0.25">
        <joint name="shoulder" range="-2.6 2.6"/>
        <inertial pos="0.3 0 0" mass="1" diaginertia="0.000341666666666667 0.0301333333333333 0.0302083333333333"/>
        <geom name="link1_box" type="box" pos="0.3 0 0" size="0.3 0.025 0.02"/>
        <geom name="shoulder_marker" type="sphere" size="0.035" contype="0" conaffinity="0"/>
        <body name="link2" pos="0.6 0 0">
          <joint name="elbow" range="-2.4 2.4"/>
          <inertial pos="0.225 0 0" mass="0.6" diaginertia="0.00014125 0.01018625 0.010205"/>
          <geom name="link2_box" type="box" pos="0.225 0 0" size="0.225 0.02 0.0175" rgba="0.73 0.48 0.25 1"/>
          <geom name="elbow_marker" type="sphere" size="0.03" contype="0" conaffinity="0"/>
          <geom name="tool_marker" type="sphere" pos="0.45 0 0" size="0.025" contype="0" conaffinity="0" rgba="0.3 0.8 0.6 1"/>
          <site name="end_effector" pos="0.45 0 0" size="0.01"/>
        </body>
      </body>
    </body>
    <geom name="target_marker" type="sphere" pos="0.888 0.254 0.25" size="0.025" contype="0" conaffinity="0" rgba="0.9 0.7 0.3 0.6"/>
    <site name="target" pos="0.888 0.254 0.25" size="0.02"/>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="1" ctrllimited="true" ctrlrange="-3 3" forcelimited="true" forcerange="-3 3"/>
    <motor name="elbow_motor" joint="elbow" gear="1" ctrllimited="true" ctrlrange="-1.5 1.5" forcelimited="true" forcerange="-1.5 1.5"/>
  </actuator>
</mujoco>
